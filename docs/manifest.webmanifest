{
  "id": "./index.html",
  "name": "BandoPM — Bandoneon Physical Modeling Synthesizer",
  "short_name": "BandoPM",
  "description": "Real-Time Bandoneon Physical Modeling Synthesizer for Bandolibre (WebAssembly AudioWorklet + WebMIDI)",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0f141c",
